ASTRA_ENVIRONMENT=development
ASTRA_API_PREFIX=/api
ASTRA_AUTO_CREATE_TABLES=false
ASTRA_CORS_ORIGINS=http://127.0.0.1:8766,http://localhost:8766
ASTRA_AUDIT_LOG_RETENTION_DAYS=365
ASTRA_CONTENT_SCRIPT_ALLOWED_HOSTS=
ASTRA_PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
ASTRA_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=300
ASTRA_PASSWORD_RESET_TOKEN_RETENTION_DAYS=30
ASTRA_PASSWORD_RESET_RETURN_TOKEN_FOR_DEV=false
ASTRA_ALERT_DELIVERY_ENABLED=false
ASTRA_ALERT_DELIVERY_PROVIDER=webhook
ASTRA_ALERT_DELIVERY_WEBHOOK_URL=
ASTRA_ALERT_DELIVERY_WEBHOOK_TOKEN=
ASTRA_ALERT_DELIVERY_TIMEOUT_SECONDS=5
ASTRA_ALERT_DELIVERY_RETRY_DELAY_SECONDS=300
ASTRA_ALERT_DELIVERY_BATCH_LIMIT=10
ASTRA_DATABASE_URL=mysql+pymysql://astra:astra@127.0.0.1:3306/astra?charset=utf8mb4
